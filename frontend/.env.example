# Langfuse evaluation environment variables
# ==========================================
# Copy this file to .env.local and fill in your actual keys.
# .env.local is git-ignored and must NOT be committed.
#
# Get your keys at: https://cloud.langfuse.com → Settings → API Keys

# Public key (safe to expose in browser builds)
VITE_LANGFUSE_PUBLIC_KEY=pk_lf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Secret key (used for server-side flushing)
VITE_LANGFUSE_SECRET_KEY=sk_lf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Langfuse cloud endpoint (default shown — change for self-hosted)
VITE_LANGFUSE_BASE_URL=https://cloud.langfuse.com
