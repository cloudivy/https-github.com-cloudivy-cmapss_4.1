# Langfuse observability (optional — app works without these)
# Get your keys from https://cloud.langfuse.com → Settings → API Keys
VITE_LANGFUSE_PUBLIC_KEY=pk-lf-...

# Override only if you are self-hosting Langfuse
# VITE_LANGFUSE_BASE_URL=https://cloud.langfuse.com

# OpenAI API key (required for Diagnosis + Maintenance agents)
# Set this in the UI or here for local development
# VITE_OPENAI_API_KEY=sk-...
